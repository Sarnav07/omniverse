# RPC endpoint for Arbitrum Sepolia
PONDER_RPC_URL_421614=https://sepolia-rollup.arbitrum.io/rpc

# Contract addresses (populated by Deploy.s.sol + SeedMarket.s.sol)
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000
LENDING_ADDRESS=0x0000000000000000000000000000000000000000

# Block number of the deploy transaction (avoids scanning from genesis)
START_BLOCK=0

# Optional: Postgres for production (Ponder defaults to SQLite in dev)
# DATABASE_URL=postgres://user:pass@localhost:5432/omniverse_indexer

# CORS origin for frontend (Vercel URL in production)
# PONDER_CORS_ORIGIN=https://omniverse.vercel.app
