# RPC endpoint for Arbitrum Sepolia
PONDER_RPC_URL_421614=https://sepolia-rollup.arbitrum.io/rpc

# Contract addresses + start block default to contracts-sol/deployments/demo-manifest.json
# (the file the deploy script writes). Only set the vars below to point the indexer at a
# DIFFERENT deployment than the manifest. A zero address or START_BLOCK=0 is treated as
# "unset" and falls back to the manifest, so do NOT copy zero placeholders here — that is
# what previously triggered a genesis-wide (~100h) scan.
# FACTORY_ADDRESS=
# RESOLVER_ADDRESS=
# LENDING_ADDRESS=
# START_BLOCK=

# Optional: Postgres for production (Ponder defaults to SQLite in dev)
# DATABASE_URL=postgres://user:pass@localhost:5432/omniverse_indexer

# CORS origin for frontend (Vercel URL in production)
# PONDER_CORS_ORIGIN=https://omniverse.vercel.app
